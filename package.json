{
  "name": "template-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "next dev | pino-pretty -c",
    "build": "next build",
    "analyze": "NODE_OPTIONS='--dns-result-order=ipv4first' next experimental-analyze",
    "start": "next start",
    "lint": "oxlint",
    "lint:style": "stylelint '**/*.{css,scss}'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typegen": "next typegen",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.215.0",
    "@opentelemetry/instrumentation-undici": "^0.25.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/sdk-trace-node": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "import-in-the-middle": "^3.0.0",
    "next": "16.3.4",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "require-in-the-middle": "^8.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-links": "^10.2.19",
    "@storybook/nextjs-vite": "^10.2.19",
    "@types/node": "^24.12.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "oxc-transform-react": "^0.148.0",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.58.2",
    "sass": "^1.97.3",
    "storybook": "^10.2.19",
    "stylelint": "^17.4.0",
    "stylelint-config-recess-order": "^7.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": "24.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
